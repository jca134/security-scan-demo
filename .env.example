# Public Google OAuth web client ID. Browser applications do not use a client secret.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: where the browser loads Spartan v6 (the team's fine-tuned sensitivity-scanner-v6 model, ~150 MB).
# It is too large for Cloudflare Pages, so host the contents of sensitivity-scanner-v6/model/onnx/
# (scanner_spec.json, tokenizer.json, tokenizer_config.json, onnx/model_fp16.onnx) elsewhere, e.g. a
# Hugging Face model repo: https://huggingface.co/<user>/<repo>/resolve/main/
# By default builds use the team's pinned Hugging Face copy (JACA369/sensitivity-scanner-v6), and
# `npm run dev` serves ../sensitivity-scanner-v6/model/onnx when that folder exists. Set this only to
# override that; set it to an empty value to hide Spartan v6.
# SPARTAN_V6_MODEL_URL=
# Optional: local folder for `npm run dev` if it isn't ../sensitivity-scanner-v6/model/onnx
# SPARTAN_V6_MODEL_DIR=
